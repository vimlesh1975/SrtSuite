<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SrtSuite</AssemblyName>
    <RootNamespace>SrtSuite</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="DeckLinkAPI.Interop">
      <HintPath>Interop\DeckLinkAPI.Interop.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <!-- Create timestamped exe (e.g. SrtSuite_ddMMyyyyHHmmss.exe), delete old timestamped exes and un-suffixed SrtSuite.exe -->
  <Target Name="TimestampExe" AfterTargets="Build">
    <PropertyGroup>
      <TimestampSuffix>$([System.DateTime]::Now.ToString("ddMMyyyyHHmmss"))</TimestampSuffix>
    </PropertyGroup>
    <ItemGroup>
      <OldTargetExes Include="$(TargetDir)$(TargetName)_*.exe" />
    </ItemGroup>
    <Delete Files="@(OldTargetExes)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe" DestinationFiles="$(TargetDir)$(TargetName)_$(TimestampSuffix).exe" Condition="Exists('$(TargetDir)$(TargetName).exe')" />
    <Delete Files="$(TargetDir)$(TargetName).exe" Condition="Exists('$(TargetDir)$(TargetName).exe')" />
  </Target>

  <Target Name="TimestampPublishExe" AfterTargets="Publish">
    <PropertyGroup>
      <TimestampSuffix>$([System.DateTime]::Now.ToString("ddMMyyyyHHmmss"))</TimestampSuffix>
    </PropertyGroup>
    <ItemGroup>
      <OldPublishExes Include="$(PublishDir)$(TargetName)_*.exe" />
    </ItemGroup>
    <Delete Files="@(OldPublishExes)" ContinueOnError="true" />
    <Copy SourceFiles="$(PublishDir)$(TargetName).exe" DestinationFiles="$(PublishDir)$(TargetName)_$(TimestampSuffix).exe" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(TargetName).exe')" />
    <Delete Files="$(PublishDir)$(TargetName).exe" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(TargetName).exe')" />
  </Target>
</Project>

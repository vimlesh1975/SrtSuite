# Intermediate build files
obj/
*.user
*.suo
.vs/
.vscode/

# Logs (ignore everywhere, including bin directories)
*.log
**/*.log
rx.log
tx.log
test_audio.log

# Duplicate ffmpeg scratch folder (already included in bin/Release/net10.0-windows/win-x64)
ffmpeg/

# Allow Release output binaries explicitly except logs and settings
!bin/
!bin/Release/
!bin/Release/net10.0-windows/
!bin/Release/net10.0-windows/win-x64/
!bin/Release/net10.0-windows/win-x64/**
bin/**/rx.log
bin/**/tx.log
bin/**/*.log
bin/**/appsettings.json
appsettings.json
**/appsettings.json
*.settings.json

